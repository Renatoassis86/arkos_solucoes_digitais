# ----------------------------------------------------------
test-results/
playwright-report/
blob-report/
.playwright/

# Screenshots/artefatos temporários de teste — não se aplica a
# capturas permanentes do futuro ARKOS Benchmark Intelligence,
# que viverão fora deste padrão (ex.: intelligence/**) e deverão
# ser versionadas ou armazenadas deliberadamente quando esse
# módulo for implementado.
tmp/
temp/
*.tmp

# ----------------------------------------------------------
# IDEs
# ----------------------------------------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# NOTA: .claude/ NÃO é ignorado — a Skill arkos-digital-intelligence
# e demais assets do Claude Code fazem parte do conhecimento
# operacional versionável do projeto.

# ----------------------------------------------------------
# Sistema operacional
# ----------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
*.log
logs/

# ----------------------------------------------------------
# Bancos locais (política provisória)
# ----------------------------------------------------------
# Ignorado por padrão enquanto não há arquitetura definida para
# o ARKOS Benchmark Intelligence. Revisar esta política quando o
# módulo de dados/benchmark for desenhado — bases que precisem
# ser versionadas ou arquivadas deliberadamente deverão ser
# excecionadas explicitamente (padrão `!caminho`) neste arquivo.
*.sqlite
*.sqlite3
*.db
